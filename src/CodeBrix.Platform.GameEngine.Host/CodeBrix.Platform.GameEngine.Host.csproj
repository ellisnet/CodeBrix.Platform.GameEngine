<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CodeBrix.Platform.GameEngine.Host</AssemblyName>
    <RootNamespace>CodeBrix.Platform.GameEngine.Host</RootNamespace>
    <!-- NRT enabled: this host consumes the NRT-on CodeBrix.Platform framework and the
         NRT-on engine core. See AGENT-README.txt. -->
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    Package / assembly version: date-stamped and auto-incrementing.

    Format:  1.<x>.<y>.<z>   (every field is derived from UTC "now")

      1  (major)     Always 1 for this library.
      x  (minor)     Whole years since $(_VersionBaseYear).
                     With base 2026: 2026=0, 2027=1, 2028=2, ...
      y  (build)     Day of year, 1-based inclusive, UTC.
                     Jan 1 = 1, Feb 1 = 32, Dec 31 = 365 (366 in a leap year).
      z  (revision)  Minute of day, UTC, range 0 to 1439.
                     00:00 = 0, 23:59 = 1439.

    The version is always strictly increasing over time:
      * within a day, z grows;
      * at a day boundary, y increments and outranks z resetting to 0;
      * at a (UTC) year boundary, x increments and outranks y and z resetting.

    Notes / caveats:
      * All fields read from System.DateTime.UtcNow, so a local dev build and a
        UTC CI build agree on the value. Math.Floor on the minutes keeps z in
        0..1439 (plain rounding could land on 1440 late in the day).
      * Because the value depends on the clock, every build produces a NEW
        version. With GeneratePackageOnBuild=true that means a fresh .nupkg on
        each build, and two builds in the SAME UTC minute produce the SAME
        version (so do not publish two packages from within one minute).
      * This is date-stamp versioning, not SemVer: minor encodes the year and
        major is pinned to 1, so major/minor do not signal API compatibility.
      * To re-baseline the minor number, change _VersionBaseYear below.
  -->
  <PropertyGroup>
    <_VersionBaseYear>2026</_VersionBaseYear>
    <_VersionYears>$([MSBuild]::Subtract($([System.DateTime]::UtcNow.Year), $(_VersionBaseYear)))</_VersionYears>
    <_VersionDayOfYear>$([System.DateTime]::UtcNow.DayOfYear)</_VersionDayOfYear>
    <_VersionMinuteOfDay>$([System.Convert]::ToInt32($([System.Math]::Floor($([System.DateTime]::UtcNow.TimeOfDay.TotalMinutes)))))</_VersionMinuteOfDay>
    <BuildVersion>1.$(_VersionYears).$(_VersionDayOfYear).$(_VersionMinuteOfDay)</BuildVersion>
    <Version>$(BuildVersion)</Version>
    <AssemblyVersion>$(BuildVersion)</AssemblyVersion>
    <FileVersion>$(BuildVersion)</FileVersion>
  </PropertyGroup>

  <!--
    This is the SINGLE published NuGet package for the game engine. It carries the
    CodeBrix.Platform.GameEngine.MitLicenseForever id and bundles BOTH assemblies: this
    Host dll plus the referenced CodeBrix.Platform.GameEngine.dll (embedded via the
    _IncludeEngineInPackage target near the bottom of this file). A consuming application
    adds only this one package reference and receives both. The engine project itself is
    <IsPackable>false</IsPackable> and produces no package of its own.
  -->
  <PropertyGroup>
    <PackageId>CodeBrix.Platform.GameEngine.MitLicenseForever</PackageId>
    <Product>CodeBrix.Platform.GameEngine</Product>
    <Title>CodeBrix.Platform.GameEngine</Title>
    <Authors>Jeremy Ellis</Authors>
    <Description>A fully managed, cross-platform 2D and 2.5D game engine for .NET, with tile maps, sprites, layered scenes, camera/view systems, animation, physics/collision, input, audio, and SkiaSharp rendering. Includes the CodeBrix.Platform host layer.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ellisnet/CodeBrix.Platform.GameEngine</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ellisnet/CodeBrix.Platform.GameEngine</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>icon-codebrix-128.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright (c) 2026 Jeremy Ellis and contributors</Copyright>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <IsPackable>true</IsPackable>
    <PackageTags>game-engine;gamedev;2d;2.5d;tilemap;sprites;scenes;skiasharp;CodeBrix</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\icon-codebrix-128.png" Pack="true" PackagePath="" />
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
    <None Include="..\..\AGENT-README.txt" Pack="true" PackagePath="" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <!-- PrivateAssets="all": do NOT emit a package dependency on the (now non-packable)
         engine project. Its dll is instead embedded directly into this package by the
         _IncludeEngineInPackage target below. -->
    <ProjectReference Include="..\CodeBrix.Platform.GameEngine\CodeBrix.Platform.GameEngine.csproj" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CodeBrix.Platform.ApacheLicenseForever" Version="1.0.210.770" />
    <PackageReference Include="CodeBrix.Platform.SkiaSharp.Views.MitLicenseForever" Version="4.150.1" />
    <PackageReference Include="CodeBrix.Platform.Graphics3DGL.ApacheLicenseForever" Version="1.0.210.770" />
    <PackageReference Include="CodeBrix.Platform.Svg.ApacheLicenseForever" Version="1.0.210.770" />
    <PackageReference Include="SkiaSharp" Version="4.150.1" />
  </ItemGroup>

  <!--
    Dependencies mirrored from the embedded engine project (CodeBrix.Platform.GameEngine).
    Because that project is packed INTO this package rather than shipped as its own
    package, its transitive NuGet dependencies do not flow to consumers automatically -
    they must be declared here so the single CodeBrix.Platform.GameEngine.MitLicenseForever
    package lists the complete dependency set. KEEP THIS BLOCK IN SYNC with the engine
    csproj's PackageReference list. (SkiaSharp is already referenced above at the same
    version, so it is not repeated here.)
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.10" />
    <PackageReference Include="CodeBrix.SkiaSvg.MitLicenseForever" Version="1.0.196.342" />
    <PackageReference Include="CodeBrix.Compression.MitLicenseForever" Version="1.0.198.139" />
    <PackageReference Include="CodeBrix.Audio.MitLicenseForever" Version="1.0.212.816" />
    <PackageReference Include="CodeBrix.Json.Extensions.MitLicenseForever" Version="1.0.196.1178" />
  </ItemGroup>

  <!--
    Embed the referenced engine assembly (and its XML docs) directly into THIS package's
    lib/<tfm> folder. Because the engine project is <IsPackable>false</IsPackable> and the
    ProjectReference above uses PrivateAssets="all", NuGet would otherwise ship neither a
    dependency nor the dll for it - so we inject the build output explicitly here.
  -->
  <PropertyGroup>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);_IncludeEngineInPackage</TargetsForTfmSpecificBuildOutput>
  </PropertyGroup>

  <Target Name="_IncludeEngineInPackage">
    <ItemGroup>
      <BuildOutputInPackage Include="$(OutputPath)CodeBrix.Platform.GameEngine.dll" Condition="Exists('$(OutputPath)CodeBrix.Platform.GameEngine.dll')" />
      <BuildOutputInPackage Include="$(OutputPath)CodeBrix.Platform.GameEngine.xml" Condition="Exists('$(OutputPath)CodeBrix.Platform.GameEngine.xml')" />
    </ItemGroup>
  </Target>

</Project>

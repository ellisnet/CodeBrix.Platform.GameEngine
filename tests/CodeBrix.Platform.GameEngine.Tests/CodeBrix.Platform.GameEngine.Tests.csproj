<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="4.0.0" />
    <PackageReference Include="SilverAssertions.ApacheLicenseForever" Version="1.0.237.1200" />
    <!-- The base SkiaSharp package carries Windows/macOS natives; Linux needs this explicit
         native-assets package for the PixelFramePresenter draw tests. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.151.0" />
    <!-- TEST PROJECT ONLY, and deliberately so. Opus is BSD-3-Clause; the engine ships as
         CodeBrix.Platform.GameEngine.MitLicenseForever and must NOT depend on it, or that package id
         stops being true. This project ships nothing, so it can reference the real codec and prove
         that a separately licensed format registered with CodeBrix.Audio becomes a first-class
         engine format (PlatformAudioFactoryTests). Do not move this reference into src/. -->
    <PackageReference Include="CodeBrix.Audio.Opus.BsdLicenseForever" Version="1.0.245.260" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CodeBrix.Platform.GameEngine\CodeBrix.Platform.GameEngine.csproj" />
  </ItemGroup>

</Project>

<Page
    x:Class="Spot.Brix.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Spot.Brix.ViewModels"
    xmlns:game="using:CodeBrix.Platform.GameEngine.Host.Rendering"
    FontFamily="{StaticResource OpenSansFont}"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.DataContext>
        <vm:MainViewModel />
    </Page.DataContext>

    <Grid Background="#FF6495ED">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="Toolbar" Grid.Row="0" Orientation="Horizontal" Spacing="14" Padding="8" Background="#FF222222" VerticalAlignment="Center">
            <Button Content="New Game" Command="{Binding NewGameCommand}" />
            <CheckBox Content="Music" Foreground="White" IsChecked="{Binding MusicEnabled, Mode=TwoWay}" />
            <CheckBox Content="Sound Effects" Foreground="White" IsChecked="{Binding SoundEffectsEnabled, Mode=TwoWay}" />
            <CheckBox Content="Jiggle" Foreground="White" IsChecked="{Binding JiggleEnabled, Mode=TwoWay}" />
            <CheckBox Content="Clouds" Foreground="White" IsChecked="{Binding CloudsEnabled, Mode=TwoWay}" />
            <CheckBox Content="GPU (on restart)" Foreground="White" IsChecked="{Binding GpuAccelerationEnabled, Mode=TwoWay}" />
            <TextBlock Text="Press S to toggle scores" Foreground="#AAFFFFFF" VerticalAlignment="Center" />
        </StackPanel>

        <game:GameSurfaceCanvas x:Name="GameCanvas" Grid.Row="1" />
    </Grid>
</Page>

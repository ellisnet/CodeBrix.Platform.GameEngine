<ContentDialog
    x:Class="Spot.Brix.Views.NewGameDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    FontFamily="{StaticResource OpenSansFont}"
    Title="New Game"
    PrimaryButtonText="Start"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <ContentDialog.Resources>
        <DataTemplate x:Key="ColorChoiceTemplate">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Width="18" Height="18" Background="{Binding Brush}" BorderBrush="#FF000000" BorderThickness="1" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="PlayerRowTemplate">
            <StackPanel Orientation="Vertical" Spacing="4" Visibility="{Binding RowVisibility}" Margin="0,0,0,10">
                <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox Width="150" Header="Name" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox Width="120"
                              Header="Played by"
                              ItemsSource="{Binding PlayerTypeNames}"
                              SelectedIndex="{Binding TypeIndex, Mode=TwoWay}" />
                    <ComboBox Width="130"
                              Header="Colour"
                              ItemsSource="{Binding ColorChoices}"
                              ItemTemplate="{StaticResource ColorChoiceTemplate}"
                              SelectedIndex="{Binding ColorIndex, Mode=TwoWay}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </ContentDialog.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
        <StackPanel Orientation="Vertical" Spacing="12" Padding="0,4,4,4">

            <StackPanel Orientation="Horizontal" Spacing="12">
                <ComboBox Width="110"
                          Header="Players"
                          ItemsSource="{Binding PlayerCounts}"
                          SelectedIndex="{Binding PlayerCountIndex, Mode=TwoWay}" />
                <ComboBox Width="110"
                          Header="Board width"
                          ItemsSource="{Binding BoardSizes}"
                          SelectedIndex="{Binding BoardWidthIndex, Mode=TwoWay}" />
                <ComboBox Width="110"
                          Header="Board height"
                          ItemsSource="{Binding BoardSizes}"
                          SelectedIndex="{Binding BoardHeightIndex, Mode=TwoWay}" />
            </StackPanel>

            <ContentControl HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Content="{Binding Player1}"
                            ContentTemplate="{StaticResource PlayerRowTemplate}" />
            <ContentControl HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Content="{Binding Player2}"
                            ContentTemplate="{StaticResource PlayerRowTemplate}" />
            <ContentControl HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Content="{Binding Player3}"
                            ContentTemplate="{StaticResource PlayerRowTemplate}" />
            <ContentControl HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Content="{Binding Player4}"
                            ContentTemplate="{StaticResource PlayerRowTemplate}" />

        </StackPanel>
    </ScrollViewer>

</ContentDialog>

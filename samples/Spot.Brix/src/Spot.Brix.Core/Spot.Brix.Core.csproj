<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <!-- Match the namespace used by the app code -->
    <RootNamespace>Spot.Brix</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />
    <PackageReference Include="CodeBrix.Platform.ApacheLicenseForever" Version="1.0.243.226" />
    <PackageReference Include="CodeBrix.Platform.Fonts.OpenSans.ApacheLicenseForever" Version="1.0.209.261" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\libs\Spot.Brix.Game\Spot.Brix.Game.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="assets\**\*" CopyToOutputDirectory="PreserveNewest" />

    <!-- The start-up splash is drawn around the repository's CodeBrix icon; it is linked rather than
         copied so there is only ever one of it in the repository. -->
    <Content Include="..\..\..\..\icon-codebrix-128.png"
             Link="assets\icon-codebrix-128.png"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

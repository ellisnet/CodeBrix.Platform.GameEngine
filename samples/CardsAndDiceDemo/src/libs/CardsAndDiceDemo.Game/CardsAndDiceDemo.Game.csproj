<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Keep a distinct RootNamespace (not the app's "CardsAndDiceDemo") so a transitive
         CodeBrix.Platform reference does not generate a duplicate GlobalStaticResources. -->
    <RootNamespace>CardsAndDiceDemo.Game</RootNamespace>
    <!-- The demo consumes the NRT-annotated CardsAndDice API; enable NRT here. -->
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <!-- The game logic owns the CardsAndDice references; the app's .Core project depends on this
       library rather than referencing the add-on directly. The CardsAndDice project brings the
       engine (the published package by default; see UseLocalEngineProject in MAINTAINER-README.txt).
       The Assets project is referenced explicitly because the sample uses AssetCatalog and the
       library's own reference to it is private (it is packed INTO the library's package). -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\..\src\CodeBrix.Platform.GameEngine.CardsAndDice\CodeBrix.Platform.GameEngine.CardsAndDice.csproj" />
    <ProjectReference Include="..\..\..\..\..\src\CodeBrix.Platform.GameEngine.CardsAndDice.Assets\CodeBrix.Platform.GameEngine.CardsAndDice.Assets.csproj" />
  </ItemGroup>
</Project>

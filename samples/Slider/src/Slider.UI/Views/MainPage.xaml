<Page
    x:Class="Slider.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Slider.ViewModels"
    xmlns:game="using:CodeBrix.Platform.GameEngine.Host.Rendering"
    FontFamily="{StaticResource OpenSansFont}"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.DataContext>
        <vm:MainViewModel />
    </Page.DataContext>

    <Grid Background="Black">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Padding="12" Spacing="8" Background="#FF222222">
            <TextBlock Text="Slider Puzzle" FontSize="18" Foreground="White" />

            <TextBlock Text="Columns" Foreground="White" />
            <TextBox Text="{Binding ColumnsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Rows" Foreground="White" />
            <TextBox Text="{Binding RowsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <Button Content="New Puzzle" HorizontalAlignment="Stretch" Command="{Binding NewPuzzleCommand}" />
            <Button Content="Shuffle" HorizontalAlignment="Stretch" Command="{Binding ShuffleCommand}" />
            <CheckBox Content="Show grid lines" Foreground="White" IsChecked="{Binding ShowGridLines, Mode=TwoWay}" />

            <TextBlock Text="{Binding CoordinateText}" Foreground="White" Margin="0,8,0,0" />
            <TextBlock Text="{Binding InfoText}" Foreground="White" FontSize="11" />
        </StackPanel>

        <game:GameSurfaceCanvas x:Name="GameCanvas" Grid.Column="1" />
    </Grid>
</Page>
